default_platform(:ios)

platform :ios do
  desc "Build and upload a new beta to TestFlight"
  lane :beta do
    # Create a CI keychain with a known password so xcodebuild can access certs
    create_keychain(
      name: "boop_ci.keychain",
      password: "boop_ci_password",
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    # Load App Store Connect API key
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: true,
      in_house: false
    )

    # Sync code signing certs and profiles into the CI keychain
    match(
      type: "appstore",
      keychain_name: "boop_ci.keychain",
      keychain_password: "boop_ci_password"
    )

    # Wire provisioning profiles to each target
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "boop-ios.xcodeproj",
      team_id: "P3PR8G7GB9",
      targets: ["boop-ios"],
      code_sign_identity: "iPhone Distribution",
      profile_name: "match AppStore ios.boop"
    )
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "boop-ios.xcodeproj",
      team_id: "P3PR8G7GB9",
      targets: ["BoopLiveActivityExtension"],
      code_sign_identity: "iPhone Distribution",
      profile_name: "match AppStore ios.boop.BoopLiveActivity"
    )

    # Bump build number to latest TestFlight build + 1
    latest = latest_testflight_build_number(app_identifier: "ios.boop")
    increment_build_number(
      build_number: latest + 1,
      xcodeproj: "boop-ios.xcodeproj"
    )

    # Build archive
    build_app(
      scheme: "boop-ios",
      project: "boop-ios.xcodeproj",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "boop-ios.ipa"
    )

    # Upload to TestFlight (no auto-release)
    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )
  end
end
